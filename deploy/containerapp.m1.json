{
  "productSlug": "booking-recovery-loop",
  "artifactClass": "web-with-backend",
  "containerPort": 8080,
  "deploy": {
    "data_dir": "/data"
  },
  "database": {
    "engine": "sqlite",
    "path": "/data/booking-recovery-loop.sqlite3",
    "journalMode": "WAL",
    "backup": "durable /data volume plus encrypted owner export"
  },
  "scale": {
    "minReplicas": 1,
    "maxReplicas": 1
  },
  "environment": {
    "PORT": "8080",
    "PUBLIC_BASE_URL": "https://booking-recovery-loop.sociobot.in",
    "SOCIOBOT_BILLING_BASE_URL": "https://api.sociobot.in/api/v1",
    "SOCIOBOT_BOOKING_PRODUCT_SLUG": "booking-recovery-loop-deposit",
    "STATIC_DIR": "/app/dist"
  },
  "integrations": {
    "billing": {
      "productSlug": "booking-recovery-loop-deposit",
      "status": "requires-factory-product-registration"
    },
    "delivery": {
      "status": "requires-factory-provisioning",
      "requiredEnvironment": [
        "DELIVERY_PROVIDER_URL",
        "DELIVERY_PROVIDER_TOKEN",
        "DELIVERY_CALLBACK_SECRET"
      ]
    }
  },
  "reason": "One product replica keeps its SQLite database and generated contact-encryption key on the mounted /data volume. The application starts with only PORT and creates both files on first boot."
}
