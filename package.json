{
  "name": "booking-recovery-loop",
  "version": "0.1.0",
  "private": true,
  "description": "Foundation tooling for Booking Recovery Loop.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:backend": "cargo fmt --manifest-path backend/Cargo.toml --check && cargo test --manifest-path backend/Cargo.toml",
    "build:backend": "cargo build --manifest-path backend/Cargo.toml --release"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.13.10",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
