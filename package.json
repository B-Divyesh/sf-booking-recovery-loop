{
  "name": "booking-recovery-loop",
  "version": "0.1.0",
  "private": true,
  "description": "Recover paid bookings with recorded consent and delivery receipts.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:claim:e2e": "npm ci --ignore-scripts && playwright test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:claims": "node scripts/verify-claims.mjs",
    "test:deployment": "node scripts/check-deployment.mjs",
    "test:server": "npm run build && cargo run --manifest-path backend/Cargo.toml",
    "test:all": "npm test && npm run check:backend && npm run test:deployment && npm run test:e2e && npm run build",
    "check:size": "node scripts/check-bundle.mjs",
    "check:backend": "cargo fmt --manifest-path backend/Cargo.toml --check && cargo test --manifest-path backend/Cargo.toml",
    "build:backend": "cargo build --manifest-path backend/Cargo.toml --release"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "22.13.10",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@azure/msal-browser": "4.18.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0"
  }
}
